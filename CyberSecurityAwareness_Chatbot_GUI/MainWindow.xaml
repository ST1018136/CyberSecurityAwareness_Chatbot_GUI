<Window x:Class="CyberSecurityAwareness_Chatbot_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Title="CyberBot - Cybersecurity Assistant">

    <Window.Resources>
        <!-- Gradient for the side menu -->
        <LinearGradientBrush x:Key="SideMenuGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A00E0" Offset="0.0"/>
            <GradientStop Color="#8E2DE2" Offset="0.3"/>
            <GradientStop Color="#FF6B9D" Offset="0.6"/>
            <GradientStop Color="#C850C0" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 3D Effect -->
        <DropShadowEffect x:Key="ThreeDEffect"
                          ShadowDepth="5"
                          BlurRadius="10"
                          Direction="315"
                          Opacity="0.5"
                          Color="#4A00E0"/>

        <DropShadowEffect x:Key="GlowEffect"
                          ShadowDepth="0"
                          BlurRadius="20"
                          Color="#FF6B9D"/>

        <!-- Menu Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Effect" Value="{StaticResource ThreeDEffect}"/>
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Contact Text Style -->
        <Style x:Key="ContactTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <!-- Social Media Icon Style -->
        <Style x:Key="SocialIconStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource ThreeDEffect}"/>
            <Style.Triggers>
                
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFD700"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                
            </Style.Triggers>
        </Style>

        <!-- Input Icon Style -->
        <Style x:Key="InputIconStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Style.Triggers>
                
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#4A00E0"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Contact Profile Style -->
        <Style x:Key="ProfileStyle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Background" Value="{StaticResource SideMenuGradient}"/>
            <Setter Property="Effect" Value="{StaticResource ThreeDEffect}"/>
        </Style>
    </Window.Resources>

    <!-- Three columns layout -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: SIDE MENU -->
        <Border Grid.Column="0" Background="{StaticResource SideMenuGradient}"
                CornerRadius="20,0,0,20"
                BorderThickness="1"
                BorderBrush="Transparent"
                ClipToBounds="True"
                Effect="{StaticResource ThreeDEffect}">
            <DockPanel LastChildFill="True">

                <!-- ASCII LOGO -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <TextBlock x:Name="SideAsciiLogo"
                               FontFamily="Consolas"
                               FontSize="9"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="10,0,10,0"
                               FontWeight="Bold"/>
                    <TextBlock Text="CYBERBOT" FontSize="17" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Cyber Security Assistant" FontSize="12"
                               Foreground="#E0E0E0" HorizontalAlignment="Center"
                               Margin="0,5,0,5"/>
                </StackPanel>

                <!-- Menu Icons with Emojis -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <Button x:Name="MenuHome" Click="MenuButton_Click" Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                            <TextBlock Text="🏠" FontSize="18" Width="20" Foreground="White"/>
                            <TextBlock Text="Home" FontSize="15" Foreground="White" VerticalAlignment="Center"
                                       Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MenuHistory" Click="MenuButton_Click" Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                            <TextBlock Text="📜" FontSize="18" Width="20" Foreground="White"/>
                            <TextBlock Text="History" FontSize="15" Foreground="White" VerticalAlignment="Center"
                                       Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MenuNotifications" Click="MenuButton_Click" Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                            <TextBlock Text="🔔" FontSize="18" Width="20" Foreground="White"/>
                            <TextBlock Text="Notifications" FontSize="15" Foreground="White" VerticalAlignment="Center"
                                       Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Settings menu at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,30">
                    <Button x:Name="MenuSettings" Click="MenuButton_Click" Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                            <TextBlock Text="⚙️" FontSize="18" Width="20" Foreground="White"/>
                            <TextBlock Text="Settings" FontSize="15" Foreground="White" VerticalAlignment="Center" 
                                       Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- COLUMN 2: CHAT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ASCII ART BACKGROUND -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000" Opacity="0.3">
                <TextBlock x:Name="BackgroundAsciiLogo"
                           FontFamily="Consolas"
                           FontSize="8"
                           
                           TextBlock.Foreground="White"
                          
                           TextAlignment="Center"
                           Text="-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-- ~                                                                                                    ~
-- ~    .-._   .-._.    .                       .-.                               .    .-.              ~
-- ~  .: (_)`-'       .'                .;;;.`-'                         .-.  ...;... (_) )-.           ~
-- ~  ::     .    .-.;-.   .-.   .;.::.;;  (_).-.  .-.     ,  :    .;.::.`-'   .'.    .-.: __)   .-.    ~
-- ~  ::   _  `:  ; ;   ;.;.-'   .;    `;;;..;.-' ;       ;   ;    .;   ;'   .;   `:  ;.:'   `. ;   ;'  ~
-- ~  `: .; )  `.'.'`::'`-`:::'.;'     _   `:`:::'`;;;;'.'`..:;._.;' _.;:._.;      `.' :'      )`;;'    ~
-- ~    `--'-.;'                      (_.;;;'                                   -.;'(_/  `----'         ~
-- ~     ...;...                                                                                        ~
-- ~      .'                                                                                            ~
-- ~    .;                                                                                              ~
-- ~  .;                                                                                                ~
-- ~                                                                                                    ~
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
"
                           TextWrapping="Wrap"
                           Opacity="0.25"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" Height="110"/>
            </Border>

            <!-- CONTACT HEADER -->
            <Border Grid.Row="0" Background="#2a2a3e" BorderBrush="#4A00E0"
                    BorderThickness="0,0,0,1" Effect="{StaticResource ThreeDEffect}"
                    Cursor="IBeam" MouseLeftButtonDown="ContactHeader_Click">
                <Grid Margin="15,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile Picture -->
                    <Border Style="{StaticResource ProfileStyle}" Grid.Column="0">
                        <TextBlock Text="🛡️" FontSize="28" TextAlignment="Center" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Contact Info -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ContactName" Text="CyberBot Assistant"
                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ContactStatus" Text="● Online - Active now"
                                   FontSize="11" Foreground="#4CAF50"/>
                    </StackPanel>

                    <!-- Online Indicator -->
                    <Border Grid.Column="2" Width="11" Height="11" CornerRadius="5"
                            Background="#4CAF50" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="0"
                                              Opacity="0.8" Color="#4CAF50"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </Border>

            <!-- CHATBOT PROFILE POPUP -->
            <Popup x:Name="ChatbotProfilePopup" PlacementTarget="{Binding ElementName=ChatScrollViewer}"
                   Placement="Center" StaysOpen="False" Width="300" Height="400">
                <Border Background="White" CornerRadius="15" BorderBrush="#4A00E0"
                        BorderThickness="2" Effect="{StaticResource ThreeDEffect}">
                    <StackPanel Margin="20">
                        <!-- Profile Image -->
                        <Border Width="80" Height="80" CornerRadius="50" 
                                Background="{StaticResource SideMenuGradient}"
                                HorizontalAlignment="Center" Margin="0,20,0,10">
                            <TextBlock Text="🛡️" FontSize="50" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="CyberBot Assistant" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,10,0,5"/>
                        <TextBlock Text="Cybersecurity Expert" FontSize="12" 
                                   Foreground="Gray" HorizontalAlignment="Center"/>

                        <Border Height="1" Background="#E0E0E0" Margin="0,15,0,15"/>

                        <!-- About Section -->
                        <TextBlock Text="About" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Hello! I am here to help you stay safe online." 
                                   FontSize="11" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"/>

                        <TextBlock Text="Expertise" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="• Password Safety" FontSize="11" Margin="10,2"/>
                        <TextBlock Text="• Phishing Detection" FontSize="11" Margin="10,2"/>
                        <TextBlock Text="• Scam Prevention" FontSize="11" Margin="10,2"/>
                        <TextBlock Text="• Safe Browsing" FontSize="11" Margin="10,2"/>

                        <Button Content="Start Conversation" 
                                Background="#4A00E0" Foreground="White"
                                BorderThickness="0"
                                Height="40" Margin="0,20,0,10"
                                Cursor="Hand" Click="CloseProfilePopup"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- CHAT MESSAGES AREA -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <StackPanel x:Name="ChatMessagesPanel" Margin="15,20"/>
            </ScrollViewer>

            <!-- INPUT AREA -->
            <Border Grid.Row="2" Background="White" Margin="15,10,15,20" 
                    CornerRadius="5" Padding="5"
                    BorderThickness="1" BorderBrush="Transparent"
                    ClipToBounds="True"
                    Effect="{StaticResource ThreeDEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Attach File Button -->
                    <Button x:Name="BtnAttachFile" Grid.Column="0" 
                            Style="{StaticResource InputIconStyle}"
                            Foreground="White"
                            Background="{StaticResource SideMenuGradient}"
                            Click="BtnAttachFile_Click"
                            ToolTip="Attach File">
                        <TextBlock Text="📎" FontSize="19"/>
                    </Button>

                    <!-- Input TextBox with Placeholder -->
                    <Grid Grid.Column="1" Margin="5,0">
                        <TextBox x:Name="UserInputTextBox" 
                                 BorderThickness="0" 
                                 FontSize="14" 
                                 Padding="10,12"
                                 Background="White"
                                 KeyDown="UserInputTextBox_KeyDown"/>
                        <TextBlock x:Name="PlaceholderText" 
                                   Text="Write your message..." 
                                   FontSize="14" 
                                   Foreground="#000000"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Visibility="Visible"/>
                    </Grid>

                    <!-- Emoji Button -->
                    <Button x:Name="BtnEmoji" Grid.Column="2" 
                            Style="{StaticResource InputIconStyle}"
                            Click="BtnEmoji_Click"
                            Background="{StaticResource SideMenuGradient}"
                            Foreground="White"
                            ToolTip="Add Emoji">
                        <TextBlock Text="😊" FontSize="20"/>
                    </Button>

                    <!-- Send Button -->
                    <Button x:Name="SendButton" Grid.Column="3" 
                            Content="➤" FontSize="18" 
                            Width="40" Height="35" 
                            Background="#4A00E0" Foreground="White"
                            BorderThickness="0" 
                            Click="SendButton_Click" 
                            Cursor="Hand" 
                            Margin="5,0,0,0"
                            ToolTip="Send Message"/>
                </Grid>
            </Border>
        </Grid>

        <!-- COLUMN 3: SOCIAL MEDIA FOOTER -->
        <Border Grid.Column="2" Background="{StaticResource SideMenuGradient}" 
                CornerRadius="0,20,20,0"
                BorderThickness="1"
                BorderBrush="Transparent"
                ClipToBounds="True"
                Effect="{StaticResource ThreeDEffect}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,30,20,30">
                    <TextBlock Text="📱 CONNECT WITH US" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                        <!-- Facebook -->
                        <Button x:Name="BtnFacebook" Style="{StaticResource SocialIconStyle}" Click="SocialMedia_Click" ToolTip="Facebook">
                            <TextBlock Text="📘" FontSize="24" Foreground="White"/>
                        </Button>

                        <!-- Instagram -->
                        <Button x:Name="BtnInstagram" Style="{StaticResource SocialIconStyle}" Click="SocialMedia_Click" ToolTip="Instagram">
                            <TextBlock Text="📷" FontSize="24" Foreground="White"/>
                        </Button>

                        <!-- Twitter -->
                        <Button x:Name="BtnTwitter" Style="{StaticResource SocialIconStyle}" Click="SocialMedia_Click" ToolTip="Twitter">
                            <TextBlock Text="X" FontSize="24" Foreground="White"/>
                        </Button>

                        <!-- WhatsApp -->
                        <Button x:Name="BtnWhatsApp" Style="{StaticResource SocialIconStyle}" Click="SocialMedia_Click" ToolTip="WhatsApp">
                            <TextBlock Text="💬" FontSize="24" Foreground="White"/>
                        </Button>
                    </WrapPanel>

                    <Border Height="1" Background="#40FFFFFF" Margin="10,10,10,20"/>

                    <TextBlock Text="📞 CONTACT US" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <StackPanel Margin="10,0">
                        <TextBlock Style="{StaticResource ContactTextStyle}">
                            <Run Text="📱 "/><Run Text="+27 123 456 789" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource ContactTextStyle}">
                            <Run Text="✉️ "/><Run Text="support@cyberbot.com" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource ContactTextStyle}">
                            <Run Text="🌐 "/><Run Text="www.cyberbot.com" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Height="1" Background="#40FFFFFF" Margin="10,20,10,20"/>

                    <TextBlock Text="📍 LOCATION" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <StackPanel Margin="10,0">
                        <TextBlock Style="{StaticResource ContactTextStyle}" TextAlignment="Center">
                            <Run Text="🏢 "/><Run Text="Gauteng, South Africa"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Height="1" Background="#40FFFFFF" Margin="10,20,10,20"/>

                    <TextBlock Text="🛡️ SECURED BY" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="10" Background="#40FFFFFF" Margin="5"
                                BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock Text="🔒" FontSize="28" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Width="50" Height="50" CornerRadius="10" Background="#40FFFFFF" Margin="5"
                                BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock Text="🛡️" FontSize="28" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Width="50" Height="50" CornerRadius="10" Background="#40FFFFFF" Margin="5"
                                BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock Text="✅" FontSize="28" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Version 2.0" 
                               FontSize="10" 
                               Foreground="#80FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>